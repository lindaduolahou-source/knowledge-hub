# Copy to .env.local and fill in values from Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optional: only this email may sign in (recommended for a personal site)
NEXT_PUBLIC_SITE_OWNER_EMAIL=you@example.com
